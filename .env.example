DATABASE_URL="postgresql://user:password@localhost:5432/largo?schema=public"

# Better Auth — must be at least 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# MercadoPago — Checkout Pro (PR 3)
# Generate from https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Webhook secret configured in MP dashboard (Notifications → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Public URL used for MP back_urls (redirect after payment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
